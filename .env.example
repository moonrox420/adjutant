# Adjutant Production Environment Configuration Template
# Copy this file to .env and adjust variables for your deployment.

# -----------------------------------------------------------------------------
# Core Server & Public Origin
# -----------------------------------------------------------------------------
ADJUTANT_PUBLIC_ORIGIN=http://localhost:3000
ADJUTANT_SECURE_COOKIES=false

# Bootstrap Owner Credentials (seeded on fresh database initialisation)
ADJUTANT_OWNER_EMAIL=operator@adjutant.local
ADJUTANT_OWNER_PASSWORD=ChangeMeImmediately123!

# -----------------------------------------------------------------------------
# Database Connection Strings (PostgreSQL)
# -----------------------------------------------------------------------------
ADJUTANT_DATABASE_URL=postgresql://adjutant_app:password@127.0.0.1:55439/adjutant
ADJUTANT_WORKER_DATABASE_URL=postgresql://adjutant_worker:password@127.0.0.1:55439/adjutant
ADJUTANT_GATEWAY_DATABASE_URL=postgresql://adjutant_gateway:password@127.0.0.1:55439/adjutant
ADJUTANT_APPROVAL_DATABASE_URL=postgresql://adjutant_approval:password@127.0.0.1:55439/adjutant

# -----------------------------------------------------------------------------
# Microservice Internal Origins
# -----------------------------------------------------------------------------
ADJUTANT_GATEWAY_URL=http://127.0.0.1:8002
ADJUTANT_APPROVAL_URL=http://127.0.0.1:8003

# -----------------------------------------------------------------------------
# Local & Cloud LLM / Inference Providers
# -----------------------------------------------------------------------------
ADJUTANT_OLLAMA_PROVIDER=local
ADJUTANT_OLLAMA_URL=http://localhost:11434
ADJUTANT_OLLAMA_MODEL=mirage335/Llama-3-NeuralDaredevil-8B-abliterated-virtuoso:latest
ADJUTANT_OLLAMA_CLOUD_MODEL=gemma4:31b-cloud
ADJUTANT_OLLAMA_CLOUD_API_KEY=

# Optional Gemini Vision / Flash API
GEMINI_API_KEY=
ADJUTANT_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# -----------------------------------------------------------------------------
# Appliance Licensing & Commercial Subscription (Lemon Squeezy / Polar)
# -----------------------------------------------------------------------------
# Provider options: 'lemonsqueezy' | 'polar' | 'custom' | 'none'
ADJUTANT_LICENSE_PROVIDER=lemonsqueezy

# Set to false in production builds to enforce active subscription key validation.
# Set to true for local development / testing without a valid license.
ADJUTANT_DEV_BYPASS_LICENSE=true

# Store / Organization ID:
# Lemon Squeezy: Numeric store ID from Dashboard -> Settings -> Stores
# Polar: Organization UUID from Dashboard -> Organization Settings
ADJUTANT_LICENSE_STORE_ID=

# API Access Key:
# Lemon Squeezy: API Key from Dashboard -> Settings -> API Keys
# Polar: Personal or Organization Access Token from Dashboard -> Settings -> Developers
ADJUTANT_LICENSE_API_KEY=

# Webhook Secret:
# Lemon Squeezy: Signing secret set in Dashboard -> Webhooks -> Add Webhook
# Polar: Webhook secret set in Dashboard -> Webhooks -> Add Webhook
ADJUTANT_LICENSE_WEBHOOK_SECRET=

# Provider-Specific Aliases also supported:
# LEMONSQUEEZY_STORE_ID=
# LEMONSQUEEZY_API_KEY=
# LEMONSQUEEZY_WEBHOOK_SECRET=
# POLAR_ORGANIZATION_ID=
# POLAR_API_KEY=
# POLAR_WEBHOOK_SECRET=
